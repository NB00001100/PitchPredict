# Copy to .env.local and fill in. The publishable key is safe in the browser:
# the view it reads is read-only under row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the deployed origin, e.g. https://pitchpredict.example (no trailing slash).
# Makes the link-preview image URLs in index.html absolute, as social sites require.
VITE_SITE_URL=
