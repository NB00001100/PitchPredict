# Copy to .env.local and fill in. These end up in the public JavaScript bundle.
VITE_SUPABASE_URL=
# The anon/publishable key: the `sb_publishable_...` key, or the legacy `anon` JWT
# (Supabase dashboard -> Project Settings -> API keys). It is safe in the browser
# because it is read-only under row-level security (see schema_frontend.sql). Never put
# the service-role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the deployed origin, e.g. https://pitchpredict.example (no trailing slash).
# Makes the link-preview image URLs in index.html absolute, as social sites require.
VITE_SITE_URL=
